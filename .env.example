# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines; Docker env files do not strip trailing comments reliably.

# development locally, production on the VPS
APP_ENV=development
APP_BASE_URL=http://localhost:8001
LOG_LEVEL=INFO
# Domain Caddy serves and gets HTTPS for, e.g. stocks.example.com on the VPS
STOCKMONITOR_DOMAIN=localhost

# Supabase project (Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Supabase > Connect > Session pooler; used only by scripts/apply_migrations.py
DATABASE_URL=

# 32+ random bytes: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Telegram (BotFather). The bot uses long polling, so no webhook is needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_CHAT_ID=

# Fyers API v3 (myapi.fyers.in)
FYERS_APP_ID=
FYERS_SECRET=
FYERS_PIN=
# Must match the redirect URL saved in your Fyers app (defaults to APP_BASE_URL/admin/fyers/callback)
FYERS_REDIRECT_URI=

# Optional: Gemini summaries of important filings (key from aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Who reads BSE: "here" (this worker) or "remote" (the Render fetcher, app/fetcher.py)
BSE_FETCH=here
# Fetcher only: secret cron-job.org sends in the X-Fetcher-Key header
FETCHER_SECRET=
